# Sovereign Agent Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_agent

# Redis (shared with ASOR for event channels)
REDIS_URL=redis://localhost:6379/0

# AWS S3 WORM Storage (shared bucket with ASOR, prefix-separated)
AWS_S3_WORM_BUCKET=sovereign-agent-worm
AWS_REGION=us-east-1
WORM_RETENTION_YEARS=7

# HashiCorp Vault (ASOR uses Transit engine for ECDSA P-256 signing)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# Base L2 Anchoring
BASE_L2_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_L2_RPC_FALLBACK_URL=https://base-sepolia.rpc.quicknode.com/YOUR_KEY
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_INTERVAL_SECONDS=300
ALCHEMY_API_KEY=
QUICKNODE_API_KEY=

# JWT / Auth
JWT_SIGNING_KEY=

# ASOR Integration
ASOR_VC_ENDPOINT=http://localhost:8000/vc/issue
ASOR_BASE_URL=http://localhost:8000

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
